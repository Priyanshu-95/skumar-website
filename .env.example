# S Kumar Construction & Interior Environment Variables

# Google Apps Script Web App Deployment URL for Form Responses
# Deploy Code.gs under infoskumarinterior@gmail.com with access set to "Anyone"
VITE_GOOGLE_SCRIPT_URL=""

# Google Analytics 4 Measurement ID (Optional)
VITE_GA_MEASUREMENT_ID=""

# =============================================================================
# Secure Hidden Project Gallery Manager (Server-Side Only - Never exposed to frontend)
# =============================================================================

# Master password used to access the image manager (change in production)
ADMIN_PASSWORD="YourStrongAdminPasswordHere!"

# Random cryptographic salt for signing secure session cookies
SESSION_SECRET="generate-a-strong-random-session-secret-here"

# GitHub Personal Access Token (PAT) with repo/contents:write permissions
# Required for committing uploaded images and metadata directly to GitHub
GITHUB_TOKEN=""

# GitHub Repository and Branch (defaults to main)
GITHUB_REPO="Priyanshu-95/skumar-website"
GITHUB_BRANCH="main"
